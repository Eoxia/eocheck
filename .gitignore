# Scan Outputs & Screenshots
outputs/*
!outputs/.gitkeep

# Logs & Temp files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log

# Operating System Files
.DS_Store
Thumbs.db
