# EOCheck Environment Configuration (Placeholders only - Do NOT put real credentials here)
PORT=3000
NODE_ENV=development
SITE_URL=http://localhost:3000

# Security (Replace with a strong random secret in production)
JWT_SECRET=your_jwt_secret_key_placeholder_change_in_prod
JWT_EXPIRES_IN=7d

# Database Connection (Supports SQLite or PostgreSQL)
DATABASE_URL=sqlite://./data/eocheck.db

# Scanner Configuration
BLACKLIGHT_TIMEOUT_MS=60000
MAX_CONCURRENT_SCANS=3
